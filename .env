# 应用配置
APP_NAME=校园情感陪伴助手
APP_VERSION=1.0.0
DEBUG=true

# 数据库配置
DATABASE_URL=sqlite:///./data/sqlite/example_db.sqlite3

# 向量数据库配置
CHROMA_PATH=./data/chroma

# Redis配置（可选）
REDIS_URL=redis://localhost:6379/0

# LLM配置
LLM_API_KEY=your-qianwen-api-key
LLM_MODEL=qwen-plus

# 语音服务配置
VOICE_SERVICE=edge-tts
